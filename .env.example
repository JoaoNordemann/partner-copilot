# Copie para .env. Nao versione tokens. Paths relativos partem do diretorio de execucao.
HF_TOKEN=

# Dados e artefatos (arquivos fixos sao derivados destes diretorios).
DATA_RAW_DIR=data/raw
DATA_SPLITS_DIR=data/splits
DATA_GOLD_DIR=data/gold
DATA_EVAL_DIR=data/eval
DATA_EXTERNAL_DIR=data/external
ANNOTATION_GUIDE_PATH=docs/annotation-guide.md
CHROMA_PATH=data/chroma
# Prefixo; o nome automatico inclui modelo e hash do contrato de embeddings.
CHROMA_COLLECTION=reviews

# Embeddings multilingues.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_PREFIX_MODE=auto

# Ingestao: omitir o limite usa a janela do modelo.
# INGESTION_CHUNK_MAX_TOKENS=120
INGESTION_CHUNK_OVERLAP_TOKENS=16
INGESTION_MAX_REVIEW_CHARS=50000

RETRIEVAL_K=8
RETRIEVAL_MIN_SCORE=0.25

# Geracao; temperatura zero seleciona decodificacao gulosa.
LLM_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
MAX_NEW_TOKENS=400
TEMPERATURE=0.3
TOP_P=0.9
