# Copie para .env. Nao versione tokens. Paths relativos partem do diretorio de execucao.
HF_TOKEN=

# Dados e artefatos (arquivos fixos sao derivados destes diretorios).
DATA_RAW_DIR=data/raw
DATA_SPLITS_DIR=data/splits
DATA_GOLD_DIR=data/gold
DATA_EVAL_DIR=data/eval/human-v2
DATA_EXTERNAL_DIR=data/external
ANNOTATION_GUIDE_PATH=docs/annotation-guide.md
CHROMA_PATH=data/chroma
# Prefixo; o nome automatico inclui modelo e hash do contrato de embeddings.
CHROMA_COLLECTION=reviews

# Embeddings multilingues.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_PREFIX_MODE=auto

# Ingestao: omitir o limite usa a janela do modelo.
# INGESTION_CHUNK_MAX_TOKENS=120
INGESTION_CHUNK_OVERLAP_TOKENS=16
INGESTION_MAX_REVIEW_CHARS=50000

RETRIEVAL_K=8
RETRIEVAL_MIN_SCORE=0.25

# Geracao; temperatura zero seleciona decodificacao gulosa.
LLM_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
MAX_NEW_TOKENS=400
TEMPERATURE=0.0
TOP_P=0.9

# Contexto e template versionado da geracao.
CONTEXT_K=5
PROMPT_VERSION=partner-copilot-v1
# Independent output contract; parser-v2 only normalizes escaped underscores.
PARSER_VERSION=parser-v1

# Seed reiniciada por pergunta; margem alem do prompt e da resposta reservada.
GENERATION_SEED=42
GENERATION_CONTEXT_MARGIN_TOKENS=256

# API direta: LLM_BACKEND é obrigatório e não tem valor padrão.
# A demo CPU e o container CPU usam fake quando não há override.
# real exige GPU; replay exige catálogo aprovado. Ambos exigem seleção explícita
# na demo CPU. O valor abaixo é o exemplo de replay, não o padrão do código.
# API_PROMPT_VERSION e API_PARSER_VERSION fixam o contrato v3 da API.
# API_REQUEST_TIMEOUT_S limita a requisição em segundos; API_MAX_PENDING limita a fila.
# API_EMBEDDING_CACHE aponta para o cache local; API_ALLOW_MODEL_DOWNLOAD libera downloads.
# API_REPLAY_CATALOG aponta para o catálogo; API_COLLECTION seleciona coleção literal.
# API_FAKE_RESPONSE_PATH seleciona a resposta fixa de teste.
LLM_BACKEND=replay
API_PROMPT_VERSION=partner-copilot-v3
API_PARSER_VERSION=parser-v3
API_REQUEST_TIMEOUT_S=60
API_MAX_PENDING=8
API_EMBEDDING_CACHE=work/hf-cache/sentence-transformers
API_ALLOW_MODEL_DOWNLOAD=false
API_REPLAY_CATALOG=work/replay-catalog.json
# API_COLLECTION=nome_literal_existente
# API_FAKE_RESPONSE_PATH=configs/fake-response.example.json

# ABSA experimental: enriquecimento e filtro exigem opt-in independente.
# ASPECT_EXTRACTOR escolhe o backend; ASPECT_PREDICTIONS_PATH aponta para predições pré-computadas.
ASPECT_ENRICHMENT_ENABLED=false
ASPECT_FILTER_ENABLED=false
ASPECT_EXTRACTOR=precomputed
# ASPECT_PREDICTIONS_PATH=reports/absa-eval-checkpoint-253-v1/retrieval-predictions.jsonl
